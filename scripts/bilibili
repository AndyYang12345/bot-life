#!/bin/sh
set -eu
TASK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHON="$TASK_ROOT/data/bilibili/venv/bin/python"
test -x "$PYTHON" || { echo 'Run scripts/setup-bilibili first.' >&2; exit 1; }
# Deliberately exclude model/OneBot credentials and inherited Python/proxy settings.
exec env -i PATH=/usr/bin:/bin LANG=C.UTF-8 TZ=Asia/Shanghai HOME="$TASK_ROOT/data/bilibili" XDG_CACHE_HOME="$TASK_ROOT/data/bilibili/cache" "$PYTHON" "$TASK_ROOT/bilibili/login.py" "${1:-status}" --directory "$TASK_ROOT/data/bilibili"

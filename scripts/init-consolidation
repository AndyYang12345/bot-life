#!/usr/bin/env python3
"""Create private, disabled-by-default consolidation configuration once."""
import json
from pathlib import Path

root = Path(__file__).resolve().parents[1]
target = root / 'data/config/consolidation.json'
target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
if target.exists():
    print('Existing memory worker configuration retained.')
else:
    config = json.loads((root / 'deploy/consolidation.example.json').read_text())
    config.update(policyFile=str(root / 'data/config/adapter.json'), healthFile=str(root / 'data/adapter/consolidation-health.json'))
    with target.open('x') as output:
        target.chmod(0o600)
        json.dump(config, output, ensure_ascii=False, indent=2)
        output.write('\n')
    print('Private memory worker configuration created; enabled=false until migration and verification.')

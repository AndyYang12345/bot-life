#!/bin/sh
set -eu
TASK_UID=$(id -u)
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$TASK_UID}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
case "${1:-status}" in
  start|stop|restart|status) systemctl --user "$1" napcat-monitor.service ;;
  *) echo 'Usage: scripts/monitor {start|stop|restart|status}' >&2; exit 2 ;;
esac

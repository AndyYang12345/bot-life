#!/usr/bin/env python3
"""Opt-in real, offline ONNX CPU/CUDA measurements; no chat or cloud model calls."""
import argparse
import json
import os
import pathlib
import selectors
import statistics
import subprocess
import tempfile
import time

root = pathlib.Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser()
parser.add_argument('--gpu', action='store_true')
args = parser.parse_args()
results = {}
for device in (['cpu', 'cuda'] if args.gpu else ['cpu']):
    python = root/'data/attention'/('venv-gpu' if device == 'cuda' else 'venv')/'bin/python'
    env = {'PATH': str(python.parent)+':/usr/bin:/bin', 'LANG': 'C.UTF-8', 'HF_HUB_OFFLINE': '1', 'HF_HUB_DISABLE_TELEMETRY': '1'}
    with tempfile.TemporaryFile(mode='w+') as errors:
        process = subprocess.Popen([str(python), str(root/'attention_backend/server.py'), '--cache-dir', str(root/'data/attention/models'), '--device', device],
                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors, text=True, env=env)
        selector = selectors.DefaultSelector()
        selector.register(process.stdout, selectors.EVENT_READ)

        def request(value):
            process.stdin.write(json.dumps({'id': 'bench', **value})+'\n')
            process.stdin.flush()
            if not selector.select(30):
                raise RuntimeError('embedding_response_timeout')
            line = process.stdout.readline()
            if not line:
                raise RuntimeError('embedding_process_failed')
            response = json.loads(line)
            if not response.get('ok'):
                raise RuntimeError('embedding_request_failed')
            return response['result']

        try:
            started = time.monotonic()
            ping = request({'ping': True})
            cold = time.monotonic()-started
            samples = []
            for i in range(30):
                result = request({'text': '你刚才说的第'+str(i)+'个步骤，能再解释一下怎样配置网络吗？', 'context': ['先安装系统，再配置网络，最后运行部署脚本。']})
                samples.append(result['elapsed_ms'])
            unrelated = request({'text': '我晚饭吃了火锅', 'context': ['先安装系统再配置网络']})
            positive = request({'text': '那个安装步骤具体怎么弄', 'context': ['先安装系统再配置网络']})
            rss = next((int(line.split()[1]) for line in pathlib.Path('/proc', str(process.pid), 'status').read_text().splitlines() if line.startswith('VmRSS:')), None)
            vram = None
            if device == 'cuda':
                rows = subprocess.check_output(['nvidia-smi', '--query-compute-apps=pid,used_gpu_memory', '--format=csv,noheader,nounits'], text=True)
                for line in rows.splitlines():
                    cells = [part.strip() for part in line.split(',')]
                    if cells[0] == str(process.pid):
                        vram = int(cells[1])
            results[device] = {'model': ping['model'], 'dimensions': ping['dimensions'], 'startupSeconds': round(cold, 3), 'uncachedSamples': len(samples),
                               'p50Ms': round(statistics.median(samples), 3), 'p95Ms': sorted(samples)[28], 'rssMiB': round(rss/1024, 1) if rss else None,
                               'vramMiB': vram, 'positive': positive, 'unrelated': unrelated}
        finally:
            process.terminate()
            process.wait(timeout=15)
            selector.close()
evidence = {'offline': True, 'cloudCalls': 0, 'results': results, 'at': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
target = root/'evidence/attention-embedding-benchmark.json'
target.parent.mkdir(mode=0o700, exist_ok=True)
target.write_text(json.dumps(evidence, indent=2))
target.chmod(0o600)
print(json.dumps(evidence))

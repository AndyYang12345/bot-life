#!/bin/sh
set -eu
TASK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TASK_UID=$(id -u)
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$TASK_UID}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
case "${1:-status}" in
  start|stop|restart) systemctl --user "$1" napcat-memory.service ;;
  status)
    systemctl --user show napcat-memory.service -p ActiveState -p SubState -p MainPID
    python3 -c 'import pathlib,json,sys;p=pathlib.Path(sys.argv[1]);print(json.dumps(json.loads(p.read_text()),ensure_ascii=False,indent=2)) if p.exists() else None' "$TASK_ROOT/data/adapter/consolidation-health.json"
    "$TASK_ROOT/scripts/life-admin" consolidation-status
    ;;
  *) echo 'Usage: scripts/memory-worker {start|stop|restart|status}' >&2; exit 2 ;;
esac

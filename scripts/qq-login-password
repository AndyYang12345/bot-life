#!/usr/bin/env python3
"""Configure optional QQ password fallback locally, without echoing credentials."""
import argparse
import getpass
import hashlib
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
SECRET = ROOT / "data/config/qq-login.md5"


class LocalParser(argparse.ArgumentParser):
    def error(self, message):
        # argparse normally echoes unknown arguments, which could be a password.
        self.exit(2, "参数无效。仅支持 set/status/check/remove；密码只能在本机隐藏输入。\n")


def read_digest(path):
    # Refuse links, other owners, public permissions and oversized input.
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    with os.fdopen(os.open(path, flags), "r", encoding="ascii") as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > 64:
            raise ValueError("凭证文件必须归当前用户所有，且只允许当前用户读写（chmod 600）。")
        value = handle.read(128).strip()
    if not re.fullmatch(r"[a-fA-F0-9]{32}", value):
        raise ValueError("凭证文件格式无效；请重新运行 set，文件内容不会显示。")
    return value.lower()


def save_password(path, password):
    parent = path.parent
    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    info = parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("凭证目录必须归当前用户所有，且只允许当前用户访问（chmod 700）。")
    if path.is_symlink():
        raise ValueError("凭证路径不能是符号链接。")
    digest = hashlib.md5(password.encode("utf-8")).hexdigest()
    fd, temporary = tempfile.mkstemp(prefix=".qq-login-", dir=parent)
    try:
        with os.fdopen(fd, "w", encoding="ascii") as handle:
            os.fchmod(handle.fileno(), 0o600)
            handle.write(digest + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def main():
    parser = LocalParser(description=__doc__)
    parser.add_argument("action", choices=("set", "status", "check", "remove"), nargs="?", default="status")
    action = parser.parse_args().action
    if action == "set":
        if not sys.stdin.isatty() or not sys.stderr.isatty():
            raise ValueError("请在本机交互终端运行；不接受聊天、管道或命令行密码参数。")
        password = getpass.getpass("专用小号 QQ 密码（隐藏输入）：")
        confirmation = getpass.getpass("再次输入：")
        if not password or password != confirmation:
            raise ValueError("两次输入不同或为空，未修改配置。")
        save_password(SECRET, password)
        del password, confirmation
        print("已保存受限的登录摘要；摘要也属于敏感凭证，不要分享。")
        print(f"执行 {ROOT}/scripts/napcat apply-login 以重建 QQ 容器并应用；数据库和记忆不受影响。")
    elif action == "remove":
        SECRET.unlink(missing_ok=True)
        print(f"已移除本机凭证文件。执行 {ROOT}/scripts/napcat apply-login 后，运行中的密码回退才会停用。")
    elif SECRET.exists() or SECRET.is_symlink():
        read_digest(SECRET)
        if action == "status":
            print("本机密码回退凭证已配置；是否已应用请查看 scripts/check-status。")
    elif action == "check":
        raise ValueError("未配置 QQ 密码回退；请先运行 scripts/qq-login-password set。")
    else:
        print("未配置 QQ 密码回退；当前仅使用缓存或扫码登录。")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, UnicodeError):
        # Never print exception text: paths, decoding errors or library messages
        # can contain credential bytes. Diagnostics stay deliberately generic.
        sys.exit("配置未完成：请检查本机交互输入、凭证格式、所有者和文件权限。凭证目录需为 700，文件需为 600。")
    except (EOFError, KeyboardInterrupt):
        sys.exit("已取消，未继续应用登录配置。")
